# OpenAI (use one LLM provider)
OPENAI_API_KEY=

# Anthropic (alternative to OpenAI)
# ANTHROPIC_API_KEY=

# SerpAPI — event search
# Get yours at: https://serpapi.com/
SERPAPI_API_KEY=

# Optional LLM overrides
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_TEMPERATURE=0.5

# Spotify — optional personalization
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8501
